# Your backend URL (local dev or deployed)
VITE_BACKEND_URL=http://localhost:3001

# GitHub Pages base path — set to /your-repo-name/ when deploying
# Leave as / for local dev
VITE_BASE_PATH=/

# Supabase (public anon key is safe to commit)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
